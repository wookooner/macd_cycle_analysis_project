# Core paths
MACD_DATA_ROOT=C:\Users\qw370\macd-cycle-data
# Optional overrides
# ANALYSIS_PROJECT_ROOT=C:\path\to\macd_cycle_analysis_project
# ANALYSIS_BASE_DATA_DIR=C:\path\to\macd_cycle_analysis_project\data\base_data
# ANALYSIS_PARQUET_DIR=C:\path\to\macd_cycle_analysis_project\data\cycle_data\structured
# ANALYSIS_HIERARCHY_MAP_PATH=C:\path\to\macd_cycle_analysis_project\data\cycle_data\structured\cycle_hierarchy_map.json

# Runtime mode
# analyze: AI analysis only, no order execution
# approve: actionable signals require Telegram approval
# auto: actionable signals execute automatically
BOT_MODE=analyze

# Data source
# external: consume data already maintained by live_update_service
# pipeline: bot also triggers update_pipeline before evaluating
DATA_SOURCE_MODE=external

# Telegram
USE_TELEGRAM=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_APPROVAL_TIMEOUT_MINUTES=30

# AI
ANTHROPIC_API_KEY=your_anthropic_key
AI_MODEL=claude-sonnet-4-20250514
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.0

# Binance
BINANCE_API_KEY=your_api_key
BINANCE_API_SECRET=your_api_secret
BINANCE_SYMBOL=BTC/USDT:USDT
BINANCE_LEVERAGE=3
BINANCE_TESTNET=true

# Trading safety
DRY_RUN=true
MAX_POSITION_PCT=30
DAILY_MAX_LOSS_PCT=5
MAX_CONSECUTIVE_LOSSES=3
MIN_DURATION_FOR_TRADE=5
CANDLE_WAIT_SECONDS=15

# Schedule
# Run right after the hourly candle closes.
# Example: 10:00:15 evaluates the fully closed 09:00-10:00 1h candle.
CRON_MINUTE=0
CRON_SECOND=15
