# ============================================
# BTC Trading Bot 환경변수
# cp .env.template .env 후 값을 채우세요
# ============================================

# ── Binance ──────────────────────────────────
BINANCE_API_KEY=your_api_key
BINANCE_API_SECRET=your_api_secret
BINANCE_LEVERAGE=3
BINANCE_TESTNET=true

# ── Telegram ─────────────────────────────────
# @BotFather로 봇 생성 → 토큰 복사
TELEGRAM_BOT_TOKEN=your_bot_token
# @userinfobot으로 채팅 ID 확인
TELEGRAM_CHAT_ID=your_chat_id

# ── Claude API ───────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key

# ── 매매 설정 ────────────────────────────────
DRY_RUN=true
MAX_POSITION_PCT=30
DAILY_MAX_LOSS_PCT=5

# ── 경로 ─────────────────────────────────────
ANALYSIS_PROJECT_ROOT=C:\Users\Administrator\Desktop\macd_cycle_analysis_project
